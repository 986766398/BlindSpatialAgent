# =====================================================================
# BlindSpatialAgent 密钥模板
#
# 用法：复制成 .env 再填自己的 Key
#     cp .env.example .env
#     # 然后编辑 .env，把 BSA_LLM_API_KEY 填上
#
# 更省事的方式（自动修断行 / 纠正大小写 / 套餐配对 + 当场实测）：
#     .venv/bin/python tools/set_llm_key.py
#
# .env 已被 .gitignore 忽略；.env.example 可以安全提交（不含真实密钥）。
# 优先级：真实环境变量 > .env > config/config.yaml
# =====================================================================

BSA_LLM_API_KEY=

# ★ 阿里云百炼有三类 Key，各自绑定不同的 Base URL，必须配套使用，混用一律 401：
#     sk-      按量付费    https://dashscope.aliyuncs.com/compatible-mode/v1
#     sk-sp-   Token Plan  https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#     sk-ws-   Coding Plan https://coding.dashscope.aliyuncs.com/v1
#   前缀必须小写；写成 Sk-sp- 即使地址正确也会 401。
BSA_LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 必须选**带视觉能力**的模型（本项目要看摄像头画面）：
#   Token Plan 实测可用：kimi-k2.5(≈1.9s) / qwen3.6-plus(≈2.9s) / qwen3.7-plus
#   通用按量付费：qwen-vl-max / qwen-vl-plus
#   OpenAI：gpt-4o
#   ⚠️ 纯文本模型（deepseek-v3.2 / qwen-turbo 等）看不到画面，不要选。
BSA_LLM_MODEL=kimi-k2.5
